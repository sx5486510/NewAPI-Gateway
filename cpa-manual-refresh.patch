+// RefreshAuthToken manually refreshes a single auth token's credentials.
+// POST /v0/management/auth-files/refresh
+// Body: {"filename": "xai-xxx.json"}
+func (h *Handler) RefreshAuthToken(c *gin.Context) {
+	if h.authManager == nil {
+		c.JSON(http.StatusServiceUnavailable, gin.H{
+			"success": false,
+			"message": "core auth manager unavailable",
+		})
+		return
+	}
+
+	var req struct {
+		Filename string `json:"filename" binding:"required"`
+	}
+
+	if err := c.ShouldBindJSON(&req); err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{
+			"success": false,
+			"message": fmt.Sprintf("Invalid request: %v", err),
+		})
+		return
+	}
+
+	filename := strings.TrimSpace(req.Filename)
+	if filename == "" {
+		c.JSON(http.StatusBadRequest, gin.H{
+			"success": false,
+			"message": "filename is required",
+		})
+		return
+	}
+
+	// Find auth by filename
+	auths := h.authManager.List()
+	var targetAuth *coreauth.Auth
+	for _, auth := range auths {
+		if auth.FileName == filename {
+			targetAuth = auth
+			break
+		}
+	}
+
+	if targetAuth == nil {
+		c.JSON(http.StatusNotFound, gin.H{
+			"success": false,
+			"message": fmt.Sprintf("Auth file not found: %s", filename),
+		})
+		return
+	}
+
+	// Check if auth has refresh credentials
+	if targetAuth.Metadata == nil {
+		targetAuth.Metadata = make(map[string]any)
+	}
+
+	refreshToken, hasRefreshToken := targetAuth.Metadata["refresh_token"].(string)
+	if !hasRefreshToken || refreshToken == "" {
+		c.JSON(http.StatusBadRequest, gin.H{
+			"success": false,
+			"message": "This auth file does not have a refresh token",
+		})
+		return
+	}
+
+	// Get old expiration time for response
+	oldExpired := ""
+	if exp, ok := targetAuth.Metadata["expired"].(string); ok {
+		oldExpired = exp
+	}
+
+	// Trigger refresh via auth manager
+	ctx, cancel := context.WithTimeout(c.Request.Context(), 30*time.Second)
+	defer cancel()
+
+	log.Infof("manually refreshing token for %s (%s)", targetAuth.Provider, targetAuth.ID)
+
+	// Call the internal refresh method
+	refreshed, err := h.authManager.RefreshAuthForRequest(ctx, targetAuth.ID, "")
+	if err != nil {
+		log.WithError(err).Errorf("failed to refresh token for %s", filename)
+		c.JSON(http.StatusInternalServerError, gin.H{
+			"success": false,
+			"message": fmt.Sprintf("Token refresh failed: %v", err),
+		})
+		return
+	}
+
+	if refreshed == nil {
+		c.JSON(http.StatusInternalServerError, gin.H{
+			"success": false,
+			"message": "Token refresh returned nil",
+		})
+		return
+	}
+
+	// Get new expiration time
+	newExpired := ""
+	if refreshed.Metadata != nil {
+		if exp, ok := refreshed.Metadata["expired"].(string); ok {
+			newExpired = exp
+		}
+	}
+
+	log.Infof("successfully refreshed token for %s (%s)", refreshed.Provider, refreshed.ID)
+
+	c.JSON(http.StatusOK, gin.H{
+		"success": true,
+		"message": "Token refreshed successfully",
+		"data": gin.H{
+			"filename":    filename,
+			"old_expired": oldExpired,
+			"new_expired": newExpired,
+		},
+	})
+}
